{
  "name": "bulletproof-react-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=/",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test-e2e": "pm2 start \"npm run run-mock-server\" --name server && npx playwright test",
    "prepare": "husky",
    "lint": "eslint src",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "generate": "plop",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
    "verify": "npm run verify:no-comments && npm run verify:vitest && npm run verify:type-coverage",
    "verify:no-comments": "bash scripts/feedback/no-comments.sh --staged --config",
    "verify:vitest": "vitest run",
    "verify:type-coverage": "type-coverage --project tsconfig.json --at-least 80"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@ngneat/falso": "^8.0.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^4.0.13",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-query-auth": "^2.4.3",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mswjs/data": "^0.16.2",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.17",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "cors": "^2.8.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "express": "^4.22.3",
    "globals": "^17.12.0",
    "husky": "^9.0.11",
    "js-cookie": "^3.0.5",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lint-staged": "^15.2.2",
    "msw": "^2.15.0",
    "openapi-msw": "^2.1.0",
    "openapi-typescript": "^7.13.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.1.0",
    "plop": "^4.0.1",
    "pm2": "^5.4.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.30.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "npm run lint",
      "bash -c 'npm run check-types'"
    ]
  }
}
